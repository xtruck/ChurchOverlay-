index f34274c..e6653a2 100644
--- a/.env.example
+++ b/.env.example
@@ -1,11 +1,58 @@
+# Copiez ce fichier en .env puis renseignez au minimum GROQ_API_KEY.
+
+# Active les logs de debug détaillés (laisser vide en production)
 DEBUG=
+
+# Fournisseur de transcription de repli si Groq échoue/timeout (optionnel)
 DEEPGRAM_API_KEY=
+
+# Clé Google Gemini pour les fonctionnalités IA (thèmes, enrichissement).
+# Repli automatique sur GROQ_API_KEY (Llama) si absente.
 GEMINI_API_KEY=
+
+# Fournisseur principal de transcription (Whisper via Groq). Obligatoire
+# pour que la détection automatique de versets fonctionne.
 GROQ_API_KEY=
+
+# Nombre max de connexions WebSocket simultanées (défaut interne si vide)
 MAX_CONNECTIONS=
+
+# Nombre max de messages WebSocket par minute et par connexion (anti-abus)
 MAX_MESSAGES_PER_MINUTE=
+
+# Seuil de détection de voix (RMS, entre 0 et 1) sous lequel un segment
+# audio est considéré comme du silence et n'est PAS envoyé à Groq/Deepgram
+# (économie de coût API + évite les faux positifs sur du bruit de fond).
+# Défaut : 0.02 — une valeur jamais calibrée avec un vrai micro de culte.
+# SI LA TRANSCRIPTION NE DÉMARRE JAMAIS malgré des clés API valides et un
+# micro qui fonctionne, ce seuil est probablement trop élevé pour votre
+# micro (moins sensible que celui utilisé pour choisir 0.02) : baissez-le
+# (ex. 0.005) et relancez. À 0, le filtre de silence est désactivé (tout
+# segment est envoyé, y compris les silences — utile pour diagnostiquer).
+MIC_SILENCE_THRESHOLD=
+
+# Port HTTP/WebSocket du serveur (défaut : 3000 si vide)
 PORT=
+
+# Active la validation stricte des messages WebSocket entrants (recommandé)
 VALIDATE_MESSAGES=
+
+# Interface d'écoute du serveur. Laisser 127.0.0.1 (défaut) tant que le
+# serveur ne doit être accessible que depuis cet ordinateur.
 WS_HOST=
+
+# Jeton d'authentification WebSocket, rôle opérateur (16 caractères
+# minimum). Obligatoire dès que WS_HOST est changé pour accepter des
+# connexions distantes (ex. 0.0.0.0) — le serveur refuse de démarrer sur un
+# WS_HOST non local sans ce jeton. Donne un contrôle complet du pipeline
+# (versets, thèmes, IA, OBS) : à réserver au tableau de bord opérateur.
 WS_AUTH_TOKEN=
+
+# Jeton d'authentification WebSocket, rôle lecture seule (16 caractères
+# minimum, DIFFÉRENT de WS_AUTH_TOKEN). À utiliser pour l'overlay collé
+# dans OBS comme Browser Source : cette URL est plus exposée que le
+# tableau de bord (visible dans les paramètres de la source OBS,
+# potentiellement partagée avec une scène OBS exportée), donc lui donner
+# le jeton opérateur reviendrait à distribuer un contrôle complet du
+# pipeline avec l'URL de l'overlay.
 WS_VIEWER_TOKEN=
\ No newline at end of file
