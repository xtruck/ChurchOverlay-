# Sentry Configuration for Error Monitoring
# Copy this to .env and fill in your Sentry DSN

# Sentry DSN (Data Source Name) - Get this from your Sentry project settings
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Sentry environment (development, staging, production)
SENTRY_ENVIRONMENT=production

# Enable performance monitoring (optional)
SENTRY_TRACES_SAMPLE_RATE=0.1

# Enable session replay (optional)
SENTRY_SESSION_REPLAY_SAMPLE_RATE=0.1