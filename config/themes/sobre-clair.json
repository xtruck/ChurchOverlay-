{
  "id": "sobre-clair",
  "name": "Sobre — Clair minimaliste",
  "author": "system",
  "readonly": false,
  "description": "Fond blanc-crème, typographie sombre, aucune animation. Idéal pour projections en journée sans fenêtres obscurcies.",
  "colors": {
    "nuit": "#F5F1E8",
    "bleuProfond": "#EFE8D6",
    "bleu": "#E5DBC0",
    "bleuClair": "#DDD1AF",
    "creme": "#2A2417",
    "or": "#7A5C1E",
    "orVif": "#8B6B24",
    "orClair": "#9A7A2E",
    "textVerse": "#1A150C"
  },
  "typography": {
    "verseFontFamily": "Georgia, 'Times New Roman', serif",
    "verseFontWeight": 400,
    "verseFontStyle": "normal",
    "verseFontSize": "clamp(2.2rem, 4.2vw, 4.8rem)",
    "verseLineHeight": 1.55,
    "referenceFontFamily": "'Manrope', 'Segoe UI', sans-serif",
    "referenceLetterSpacing": "0.10em",
    "referenceTextTransform": "uppercase"
  },
  "effects": {
    "showCross": false,
    "showRays": false,
    "showHalo": false,
    "showParticles": false,
    "showGrain": false,
    "showGoldSeparator": true,
    "showBackgroundGradient": true,
    "backdropBlur": "0px",
    "cardOpacity": 0,
    "cardBorderRadius": "0px"
  },
  "backgroundImage": {
    "type": "none",
    "source": null,
    "opacity": 0,
    "kenBurns": false
  }
}
