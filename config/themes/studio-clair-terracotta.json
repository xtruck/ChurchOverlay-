{
  "id": "studio-clair-terracotta",
  "name": "Studio Clair — Terracotta",
  "author": "system",
  "readonly": true,
  "description": "Version la plus chaude et affirmée : fond pêche/terracotta dégradé, typographie plus dense. Pour une identité de marque plus présente à l'écran.",
  "colors": {
    "background": {
      "type": "gradient",
      "stops": [
        { "color": "#FBEEE7", "position": 0 },
        { "color": "#F5DDCB", "position": 50 },
        { "color": "#E8C4A5", "position": 100 }
      ],
      "angle": 160
    },
    "accent": "#B8622F",
    "accentBright": "#8F4A20",
    "text": "#2B2620",
    "reference": "#8F4A20"
  },
  "typography": {
    "verseFontFamily": "'Newsreader', Georgia, serif",
    "verseFontWeight": 600,
    "verseFontSize": "clamp(2.4rem, 4.4vw, 5rem)",
    "referenceFontFamily": "'IBM Plex Sans', sans-serif",
    "referenceLetterSpacing": "0.08em"
  },
  "effects": {
    "showCross": false,
    "showRays": false,
    "showHalo": false,
    "showParticles": false,
    "showGrain": true,
    "borderRadius": "20px",
    "blurBackdrop": "24px",
    "goldSeparator": true
  },
  "animations": {
    "entryAnimation": "focus-in",
    "entrySpeed": 1.1,
    "exitAnimation": "fondu",
    "kineticTypography": false
  },
  "backgroundImage": {
    "type": "none",
    "source": null,
    "kenBurns": false,
    "opacity": 0
  }
}
