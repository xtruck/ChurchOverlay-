+      reconnectTimer = null;
+    }
+    // AJOUT : (re)démarre l'auto-détection du mode de culte à chaque
+    // connexion/reconnexion — pas d'effet si déjà démarré (voir
+    // startSermonModeAutoDetect, protégé contre le double-démarrage).
+    startSermonModeAutoDetect();
