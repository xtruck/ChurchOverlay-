+  ws.onerror = (err) => {
+    console.error('Erreur WebSocket :', err);
+    updateStatus(false);
+  };
+
+  ws.onclose = () => {
+    console.log('Déconnecté du serveur ChurchOverlay');
+    updateStatus(false);
+    stopSermonModeAutoDetect();
+    scheduleReconnect();
+  };
+}
