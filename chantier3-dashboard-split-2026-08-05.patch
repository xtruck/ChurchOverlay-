+  reconnectAttempts++;
+  const delay = Math.min(2000 * reconnectAttempts, 10000);
+  updateStatus(false, reconnectAttempts);
+  reconnectTimer = setTimeout(() => {
+    reconnectTimer = null;
+    initWebSocket();
+  }, delay);
+}
