{
  "name": "churchoverlay",
  "productName": "ChurchOverlay",
  "version": "0.1.0",
  "description": "Overlay de versets bibliques en direct — micro → FFmpeg → Whisper/Groq → detector → overlay.html, packagé en application Windows installable.",
  "author": "ChurchOverlay",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "server-only": "node server.js",
    "test-envoi": "node tests/test-envoi.js",
    "setup-whisper": "node setup-whisper.js",
    "setup-ffmpeg": "node setup-ffmpeg.js",
    "test": "node tests/test-detector.js && node tests/test-validation.js && node tests/test-rate-limiter.js && node tests/test-config-validator.js && node tests/test-groq-fallback-race.js",
    "test-all": "node tests/test-detector.js && node tests/test-validation.js && node tests/test-rate-limiter.js && node tests/test-config-validator.js && node tests/test-groq-fallback-race.js && node tests/test-audio-capture.js && node tests/test-whisper.js && node tests/test-pipeline-complet.js",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "form-data": "^4.0.6",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.mesev.churchoverlay",
    "productName": "ChurchOverlay",
    "asar": false,
    "files": [
      "main.js",
      "preload.js",
      "setup.html",
      "dashboard.html",
      "overlay.html",
      "server.js",
      "audio-capture.js",
      "bible-lookup-with-api.js",
      "config-validator.js",
      "context-tracker.js",
      "detector.js",
      "groq-wrapper.js",
      "deepgram-wrapper.js",
      "list-audio-devices.js",
      "rate-limiter.js",
      "setup-whisper.js",
      "setup-ffmpeg.js",
      "ffmpeg/**/*",
      "validation.js",
      "whisper-wrapper.js",
      "icon.png",
      "icon.ico",
      "package.json",
      "!tests/**",
      "!**/*.md",
      "!**/*.bat",
      "!**/*.vbs"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ChurchOverlay"
    }
  }
}
