{
  "name": "churchoverlay",
  "productName": "ChurchOverlay",
  "version": "1.0.7",
  "private": true,
  "description": "Live Bible-verse detection and overlay for OBS, built as a small deterministic pipeline (see ARCHITECTURE.md).",
  "main": "dist/apps/desktop/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"apps/**/*.ts\" \"packages/**/*.ts\" \"scripts/**/*.ts\" \"apps/desktop/renderer/audio-stream.js\"",
    "start": "npm run build && electron .",
    "start:web": "npm run build && node dist/apps/web/index.js",
    "test": "tsc && cd dist && node --test",
    "test:live-groq": "tsc && cd dist && node --env-file=../.env --test apps/server/asr/groq-provider.live.test.js",
    "test:live-bible": "tsc && cd dist && node --env-file=../.env --test apps/server/verse/free-api-source.live.test.js",
    "dev:preview": "tsc && node --env-file=.env dist/scripts/dev-preview.js",
    "dry-run": "tsc && node dist/scripts/dry-run.js",
    "rebuild:native": "electron-rebuild -f -w @stagetimerio/grandiose",
    "package": "npm run build && npm run rebuild:native && electron-builder --dir",
    "dist": "npm run build && npm run rebuild:native && electron-builder"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0",
    "eslint": "^9.39.5",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.0"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "ws": "^8.22.0"
  },
  "build": {
    "appId": "com.churchoverlay.app",
    "productName": "ChurchOverlay",
    "directories": {
      "output": "release"
    },
    "electronLanguages": [
      "en-US",
      "fr"
    ],
    "compression": "maximum",
    "asarUnpack": [
      "node_modules/@stagetimerio/grandiose/dist/**"
    ],
    "files": [
      "dist/apps/**/*",
      "dist/packages/**/*",
      "apps/desktop/renderer/**/*.html",
      "apps/desktop/renderer/**/*.js",
      "apps/desktop/renderer/fonts/**/*",
      "apps/desktop/renderer/**/*.css",
      "apps/overlay/public/**/*",
      "apps/remote/public/**/*",
      "apps/stage/public/**/*",
      "apps/live/public/**/*",
      "apps/server/verse/data/**/*",
      "apps/server/asr/faster-whisper-sidecar/*.py",
      "assets/icons/icon.png",
      "package.json",
      "!**/*.test.js",
      "!**/*.test.js.map",
      "!**/*.map",
      "!node_modules/shelljs/**",
      "!node_modules/fast-glob/**",
      "!node_modules/micromatch/**",
      "!node_modules/braces/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icons/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icons/icon.icns",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icons/icon.png",
      "category": "AudioVideo"
    }
  },
  "optionalDependencies": {
    "@stagetimerio/grandiose": "^0.2.0"
  },
  "allowScripts": {
    "@stagetimerio/grandiose@0.2.0": true
  },
  "overrides": {
    "tmp": "^0.2.7",
    "body-parser": "^1.20.9"
  }
}
