{
  "name": "churchoverlay",
  "productName": "ChurchOverlay",
  "version": "1.0.0",
  "private": true,
  "description": "Live Bible-verse detection and overlay for OBS, built as a small deterministic pipeline (see ARCHITECTURE.md).",
  "main": "dist/apps/desktop/main/index.js",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && electron .",
    "start:web": "npm run build && node dist/apps/web/index.js",
    "test": "tsc && cd dist && node --test",
    "test:live-groq": "tsc && cd dist && node --env-file=../.env --test apps/server/asr/groq-provider.live.test.js",
    "dev:preview": "tsc && node --env-file=.env dist/scripts/dev-preview.js",
    "dry-run": "tsc && node dist/scripts/dry-run.js",
    "rebuild:native": "electron-rebuild -f -w @stagetimerio/grandiose",
    "package": "npm run build && npm run rebuild:native && electron-builder --dir",
    "dist": "npm run build && npm run rebuild:native && electron-builder"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "ws": "^8.21.3"
  },
  "build": {
    "appId": "com.churchoverlay.app",
    "productName": "ChurchOverlay",
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "node_modules/@stagetimerio/grandiose/dist/**"
    ],
    "files": [
      "dist/apps/**/*",
      "dist/packages/**/*",
      "apps/desktop/renderer/**/*.html",
      "apps/desktop/renderer/**/*.js",
      "apps/overlay/public/**/*",
      "apps/remote/public/**/*",
      "apps/server/verse/data/**/*",
      "package.json",
      "!**/*.test.js",
      "!**/*.test.js.map",
      "!**/*.map"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": "AppImage",
      "category": "AudioVideo"
    }
  },
  "optionalDependencies": {
    "@stagetimerio/grandiose": "^0.2.0"
  }
}
