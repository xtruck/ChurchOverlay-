{
  "name": "churchoverlay",
  "productName": "ChurchOverlay",
  "version": "0.5.0",
  "description": "Overlay de versets bibliques en direct avec IA — détection sémantique, commandes vocales, thèmes dynamiques et recherche biblique par sujet.",
  "author": "ChurchOverlay",
  "main": "main.js",
  "scripts": {
    "build": "npm run build:ts",
    "dev": "node server.js",
    "start": "node server.js",
    "server-only": "node --env-file-if-exists=.env --env-file-if-exists=.env.local server.js",
    "test-envoi": "node test/test-envoi.js",
    "check-files": "node scripts/check-build-files.js",
    "pretest": "node ./scripts/check-test-files.js",
    "test": "node scripts/check-build-files.js && node test/test-detector.js && node test/test-detector-en.js && node test/test-validation.js && node test/test-rate-limiter.js && node test/test-config-validator.js && node test/test-groq-fallback-race.js && node test/test-theme-loader.js && node test/test-features-store.js && node test/test-audio-capture.js && node test/test-sentence-buffer.js && node test/test-reading-mode.js && node test/test-obs-gating.js && node test/test-ws-auth.js && node test/integration-reading-mode-live.js && node test/integration-quote-match.js",
    "test-all": "node scripts/check-build-files.js && node test/test-detector.js && node test/test-detector-en.js && node test/test-validation.js && node test/test-rate-limiter.js && node test/test-config-validator.js && node test/test-groq-fallback-race.js && node test/test-theme-loader.js && node test/test-features-store.js && node test/test-audio-capture.js && node test/test-sentence-buffer.js && node test/test-reading-mode.js && node test/test-obs-gating.js && node test/test-ws-auth.js && node test/integration-reading-mode-live.js && node test/integration-quote-match.js",
    "dist": "electron-builder",
    "lint": "eslint . --ext .ts,.js",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "type-check": "tsc --noEmit",
    "build:ts": "tsc",
    "security:audit": "npm audit",
    "security:fix": "npm audit fix"
  },
  "dependencies": {
    "@google/genai": "^2.14.0",
    "electron-updater": "^6.3.0",
    "express": "^4.18.2",
    "form-data": "^4.0.6",
    "obs-websocket-js": "^5.0.6",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "electron": "43.3.0",
    "electron-builder": "^26.15.7",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "minimatch": "^10.2.6"
  },
  "build": {
    "appId": "com.mesev.churchoverlay",
    "productName": "ChurchOverlay",
    "asar": true,
    "compression": "maximum",
    "files": [
      "main.js",
      "preload.js",
      "perf-monitor.js",
      "setup.html",
      "dashboard.html",
      "overlay.html",
      "server.js",
      "sentence-buffer.js",
      "audio-capture.js",
      "prompt-sanitizer.js",
      "bible-keyterms.js",
      "bible-lookup-with-api.js",
      "config-validator.js",
      "context-tracker.js",
      "detector.js",
      "detector-en.js",
      "detector-compat.js",
      "levenshtein.js",
      "reading-mode.js",
      "groq-wrapper.js",
      "deepgram-wrapper.js",
      "rate-limiter.js",
      "logger.js",
      "validation.js",
      "theme-loader.js",
      "features-store.js",
      "obs-controller.js",
      "auto-updater.js",
      "semantic-detector.js",
      "voice-commands.js",
      "transcription-corrector.js",
      "bible-semantic-search.js",
      "plugin-system.js",
      "ai-theme-generator.js",
      "ai-enricher.js",
      "global.d.ts",
      "tsconfig.json",
      "node_modules/express/**/*",
      "config/themes/**/*",
      "config/features.json",
      "config/plugins/**/*",
      "icon.png",
      "icon.ico",
      "package.json",
      "!test/**",
      "!**/*.md",
      "!**/*.bat",
      "!**/*.vbs",
      "!**/*.map",
      "!**/*.log",
      "!**/*.test.js",
      "!**/.DS_Store",
      "!dist/**",
      "!**/node_modules/*/{CHANGELOG.md,README.md,readme.md,readme.markdown}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/.cache"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ChurchOverlay",
      "differentialPackage": true
    },
    "publish": {
      "provider": "github",
      "owner": "xtruck",
      "repo": "xtruck",
      "releaseType": "release"
    }
  }
}
