diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index a77a85f..0e69847 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -92,6 +92,19 @@ jobs:
       - name: Install dependencies
         run: npm ci
 
+      # CORRECTIF (segfault CI 2026-08-05) : le job "Run Tests" plantait en
+      # "Segmentation fault (core dumped)" sur ubuntu-latest/Node 20.x, au
+      # moment précis où server.js (via session-store.js) charge le binaire
+      # natif de better-sqlite3. Ce module n'a pas de binaire prébuilt
+      # (pas de champ "binary" dans son package.json — il compile via
+      # node-gyp) : un binaire natif compilé pour une ABI Node différente
+      # (ex. un artefact de cache réutilisé entre jobs de la matrice) plante
+      # au chargement plutôt que de lever une erreur JS propre. On force ici
+      # une recompilation depuis les sources pour l'ABI Node exacte de CE
+      # job, quel que soit ce que `npm ci` a pu récupérer par ailleurs.
+      - name: Rebuild native modules (better-sqlite3)
+        run: npm rebuild better-sqlite3 --build-from-source
+
       - name: List test directory
         shell: bash
         run: |
diff --git a/.github/workflows/tests.yml b/.github/workflows/tests.yml
index e29a366..5831350 100644
--- a/.github/workflows/tests.yml
+++ b/.github/workflows/tests.yml
@@ -31,6 +31,13 @@ jobs:
       - name: Installer les dépendances
         run: npm ci
 
+      # CORRECTIF (segfault CI 2026-08-05, voir ci.yml pour le détail) :
+      # better-sqlite3 n'a pas de binaire prébuilt — force une recompilation
+      # native pour l'ABI Node exacte de ce job avant d'exécuter les tests,
+      # qui chargent ce module via server.js/session-store.js.
+      - name: Recompiler les modules natifs (better-sqlite3)
+        run: npm rebuild better-sqlite3 --build-from-source
+
       - name: Vérifier la syntaxe de tous les fichiers .js
         run: |
           for f in $(git ls-files '*.js'); do
