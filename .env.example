# Church Overlay Configuration Example
# Copy this file to .env and fill in your values
# NEVER commit .env with real API keys!

# ============================================================================
# WebSocket Server Configuration
# ============================================================================

# Port for WebSocket server (default: 8765)
PORT=8765

# Host binding (default: 127.0.0.1 for local only, for security)
# WARNING: Binding to 0.0.0.0 allows remote connections - only for testing
WS_HOST=127.0.0.1

# ============================================================================
# Audio Capture Configuration (FFmpeg)
# ============================================================================

# Name of the audio device (microphone)
# Run: node list-audio-devices.js to see available devices
AUDIO_DEVICE=Microphone

# Path to FFmpeg executable (optional if already in system PATH)
# Windows example: C:\ffmpeg\bin\ffmpeg.exe
# Linux/Mac example: /usr/local/bin/ffmpeg
FFMPEG_PATH=

# ============================================================================
# Speech-to-Text Configuration
# ============================================================================

# Groq API key for cloud transcription (Optional)
# Get it from: https://console.groq.com/keys
# If not provided, system uses local Whisper only
# Benefits of Groq: Better accuracy for noisy environments
GROQ_API_KEY=

# Node environment (development, production, test)
NODE_ENV=production

# ============================================================================
# Bible Content Configuration
# ============================================================================

# Bible data provider (local, api, or both)
# Options: 'local' (JSON file), 'api' (external API), 'both' (try local first, fallback to API)
BIBLE_PROVIDER=both

# Bible API key (if using external provider)
# Example providers:
# - https://api.scripture.api.bible/ (requires paid plan)
# - https://getbible.net/ (free, requires registration)
BIBLE_API_KEY=

# ============================================================================
# Logging and Debugging
# ============================================================================

# Debug mode (set to true for verbose logging)
DEBUG=false

# ============================================================================
# Security Configuration
# ============================================================================

# Maximum concurrent WebSocket connections per IP (default: 10)
MAX_CONNECTIONS=10

# Maximum messages per minute per IP (default: 60)
MAX_MESSAGES_PER_MINUTE=60

# Enable WebSocket message validation (default: true, keep enabled!)
VALIDATE_MESSAGES=true
