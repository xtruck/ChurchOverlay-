# Church Overlay Configuration Example
# Copy this file to .env and fill in your values
# NEVER commit .env with real API keys!

# ============================================================================
# WebSocket Server Configuration
# ============================================================================

# Port for WebSocket server (default: 8765)
PORT=8765

# Host binding (default: 127.0.0.1 for local only, for security)
# WARNING: Binding to 0.0.0.0 allows remote connections - only for testing
WS_HOST=127.0.0.1

# ============================================================================
# Audio Capture
# ============================================================================
# Microphone capture is done natively in the renderer via getUserMedia
# (dashboard.html / setup.html) — there is no server-side audio device
# configuration and no FFmpeg dependency. The microphone is picked from the
# app's own setup screen, not from an environment variable.

# ============================================================================
# Speech-to-Text Configuration (cloud-only)
# ============================================================================

# Groq API key for cloud transcription (recommended primary provider)
# Get it from: https://console.groq.com/keys
GROQ_API_KEY=

# Deepgram API key (optional fallback, used if Groq fails or times out)
# Get it from: https://console.deepgram.com/
DEEPGRAM_API_KEY=

# Node environment (development, production, test)
NODE_ENV=production

# ============================================================================
# Bible Content Configuration
# ============================================================================
# Verse text is fetched directly from two independent free providers with
# automatic fallback (bible.helloao.org, then api.getbible.net). No API key
# or provider selection is needed or used.

# ============================================================================
# Logging and Debugging
# ============================================================================

# Debug mode (set to true for verbose logging)
DEBUG=false

# ============================================================================
# Security Configuration
# ============================================================================

# Maximum concurrent WebSocket connections per IP (default: 10)
MAX_CONNECTIONS=10

# Maximum messages per minute per IP (default: 60)
MAX_MESSAGES_PER_MINUTE=60

# Enable WebSocket message validation (default: true, keep enabled!)
VALIDATE_MESSAGES=true
