# Used by scripts/dev-preview.ts, scripts/dry-run.ts, and the live Groq
# integration test (npm run test:live-groq). The desktop app itself does
# not read this file — its own setup screen collects and stores these via
# ConfigStore instead.

# Required for real-time transcription via Groq's Whisper endpoint, and
# for AI-generated sermon notes.
GROQ_API_KEY=

# Optional. Web Server Mode (apps/web/index.ts, ARCHITECTURE.md section 80)
# only — fixed operator/viewer WebSocket tokens instead of randomly
# generated ones each run. Not used by the desktop app.
OPERATOR_TOKEN=
VIEWER_TOKEN=

# Optional. Web Server Mode only — the address to listen on. Defaults to
# 127.0.0.1 (this machine only). Set it (e.g. 0.0.0.0) only to reach the
# server from a phone or another machine on a trusted network: anyone who
# can reach the port and holds a page URL holds that page's token.
WEB_HOST=

# Optional, test-only. Path to a real whisper.cpp `whisper-server` binary and
# its model file, used only by the gated real-engine test in
# apps/server/asr/local-whisper-provider.test.ts (it self-skips when either is
# unset, exactly like the live Groq test). Never read by the app itself.
WHISPER_SERVER_BIN=
WHISPER_MODEL=
