# Copiez ce fichier en .env puis renseignez au minimum GROQ_API_KEY.

# Fournisseur de transcription de repli si Groq échoue/timeout (optionnel)
DEEPGRAM_API_KEY=

# Clé Google Gemini pour les fonctionnalités IA (thèmes, enrichissement).
# Repli automatique sur GROQ_API_KEY (Llama) si absente.
GEMINI_API_KEY=

# Embeddings pour la recherche biblique sémantique (voir embedding-provider.js) :
# Ollama local est essayé EN PREMIER si joignable (aucune clé, aucun quota —
# installez-le depuis https://ollama.com puis `ollama pull bge-m3`), GEMINI_API_KEY
# sert de repli sinon. Ni l'un ni l'autre -> repli mot-clé, honnête et fonctionnel.
# Facultatif, valeurs par défaut déjà correctes pour une install locale standard :
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_EMBED_MODEL=bge-m3

# Agent opérateur (OpenAI-compatible, Groq par défaut)
AGENT_API_KEY=
AGENT_MODEL=openai/gpt-oss-20b
AGENT_PROVIDER=groq-compatible
# Base URL facultative pour un endpoint OpenAI-compatible différent
AGENT_BASE_URL=https://api.groq.com/openai/v1
# Dossier persistant des sessions/checkpoints agent (défaut : dossier utilisateur)
CHURCHOVERLAY_DATA_DIR=

# Fournisseur principal de transcription (Whisper via Groq). Obligatoire
# pour que la détection automatique de versets fonctionne.
GROQ_API_KEY=

# Moteur de transcription (ASR), voir asr-engine.js. 'auto' (défaut si vide) :
# comportement historique inchangé — Groq et Deepgram (batch) lancés en
# parallèle, premier qui répond gagne. 'groq' force Groq seul. 'deepgram'
# active le STREAMING TEMPS RÉEL (WebSocket, voir deepgram-streaming.js) —
# EXPÉRIMENTAL : le protocole est codé selon la documentation publique
# Deepgram et testé via une connexion simulée, mais PAS encore vérifié
# contre une vraie clé/serveur Deepgram. Repli automatique sur le pipeline
# segment/Groq classique si la connexion streaming échoue ou tombe en cours
# de culte — aucun risque de silence total, mais à tester en conditions
# réelles avant un usage en production. 'qwen-local' est réservé, pas
# implémenté (aucun compilateur C/C++ détecté dans l'environnement de
# développement — voir asr-engine.js).
ASR_PROVIDER=

# Nombre max de connexions WebSocket simultanées (défaut interne si vide)
MAX_CONNECTIONS=

# Nombre max de messages WebSocket par minute et par connexion (anti-abus)
MAX_MESSAGES_PER_MINUTE=

# Seuil de détection de voix (RMS, entre 0 et 1) sous lequel un segment
# audio est considéré comme du silence et n'est PAS envoyé à Groq/Deepgram
# (économie de coût API + évite les faux positifs sur du bruit de fond).
# Défaut : 0.02 — une valeur jamais calibrée avec un vrai micro de culte.
# SI LA TRANSCRIPTION NE DÉMARRE JAMAIS malgré des clés API valides et un
# micro qui fonctionne, ce seuil est probablement trop élevé pour votre
# micro (moins sensible que celui utilisé pour choisir 0.02) : baissez-le
# (ex. 0.005) et relancez. À 0, le filtre de silence est désactivé (tout
# segment est envoyé, y compris les silences — utile pour diagnostiquer).
MIC_SILENCE_THRESHOLD=

# Fournisseur de détection de voix (VAD). 'auto' (défaut si vide) : VAD
# neuronal (Silero, modèle local models/silero_vad.onnx) si le modèle
# charge correctement, repli automatique et silencieux sur le seuil RMS
# ci-dessus sinon — jamais d'échec dur du pipeline audio pour ça. 'silero'
# force Silero (même comportement de repli si le chargement échoue). 'rms'
# désactive Silero et force l'ancien comportement RMS uniquement. Silero
# distingue un vrai signal de parole d'un bruit fort (musique, sono,
# ventilateur) — un seuil RMS seul ne le peut pas.
VAD_PROVIDER=

# Silence continu (ms) après de la voix avant que le VAD local considère
# l'énoncé terminé et coupe. Défaut : 600 si vide — NE PAS augmenter sans
# mesure (voir live-tests/BASELINE_CHANTIER_1.md, Chantier A.4/B, piste D5) :
# une valeur plus haute retarde CHAQUE finalisation d'énoncé d'autant,
# latence payée par tout le monde pour rattraper un cas de pause longue
# après un nom de livre isolé avant le chapitre/verset.
TRAILING_SILENCE_MS=

# Port HTTP/WebSocket du serveur (défaut : 8765 si vide)
PORT=

# Optionnel : langue de décodage ASR par défaut AU DÉMARRAGE (ex. "fr",
# "en") pour booster la précision sur des segments courts/bruités. Laisser
# vide pour garder la détection automatique de Groq/Whisper (Deepgram,
# lui, n'a jamais de détection automatique — voir deepgram-wrapper.js).
# N'EST PLUS Groq-uniquement (support bilingue FR/EN) : ceci n'est qu'un
# défaut de démarrage — pendant le culte, l'opérateur peut changer la
# langue de transcription EN DIRECT par commande vocale ("écoute en
# français"/"listen in English", voir voice-commands.js), sans redémarrer
# l'app ; cette valeur de session prend alors le dessus sur celle-ci.
# Deepgram est en pratique limité ici à fr/en (voir config-validator.js) ;
# Groq/Whisper accepte n'importe quel code ISO 639-1 plausible.
TRANSCRIPTION_LANGUAGE=

# Seuil de confiance (0-1) en dessous duquel un segment transcrit est rejeté
# (bruit de fond, écho de sono, parole inintelligible) plutôt qu'affiché comme
# sous-titre/verset détecté — évite qu'un verset s'affiche sans avoir été
# prononcé. Actif par défaut à 0.15 (voir DEFAULT_TRANSCRIPTION_CONFIDENCE_THRESHOLD
# dans server.js) même si cette variable est vide ; réglable en direct sans
# redémarrage via config/features.json → audio.transcriptionConfidenceThreshold
# (prioritaire sur cette variable). Laissez cette variable vide pour garder le
# défaut, ou mettez 0 pour désactiver complètement le rejet.
TRANSCRIPTION_CONFIDENCE_THRESHOLD=

# Délai (ms) avant d'afficher le CHAPITRE ENTIER quand l'ASR n'a livré que
# livre+chapitre (numéro de verset tronqué/perdu) — règle mission : jamais un
# mauvais verset affiché, verset exact OU chapitre. Arbitrage mesuré
# couverture/latence (voir live-tests/BASELINE_CHANTIER_1.md, Chantier A.5) :
# +13,5 points de couverture au prix de +1,3s de p50 avec le défaut de 3000ms.
# Un délai plus court affiche le chapitre plus tôt mais laisse moins de temps
# à un verset exact (plus précis) d'arriver avant lui. Actif par défaut à
# 3000 (voir DEFAULT_CHAPTER_FALLBACK_MS dans server.js) même si cette
# variable est vide ; réglable en direct sans redémarrage via
# config/features.json → display.chapterFallbackDelayMs (prioritaire sur
# cette variable). Laissez cette variable vide pour garder le défaut.
CHAPTER_FALLBACK_MS=

# Active la validation stricte des messages WebSocket entrants (recommandé)
VALIDATE_MESSAGES=

# Interface d'écoute du serveur. Laisser 127.0.0.1 (défaut) tant que le
# serveur ne doit être accessible que depuis cet ordinateur.
WS_HOST=

# Jeton d'authentification WebSocket, rôle opérateur (16 caractères
# minimum). Obligatoire dès que WS_HOST est changé pour accepter des
# connexions distantes (ex. 0.0.0.0) — le serveur refuse de démarrer sur un
# WS_HOST non local sans ce jeton. Donne un contrôle complet du pipeline
# (versets, thèmes, IA, OBS) : à réserver au tableau de bord opérateur.
WS_AUTH_TOKEN=

# Jeton d'authentification WebSocket, rôle lecture seule (16 caractères
# minimum, DIFFÉRENT de WS_AUTH_TOKEN). À utiliser pour l'overlay collé
# dans OBS comme Browser Source : cette URL est plus exposée que le
# tableau de bord (visible dans les paramètres de la source OBS,
# potentiellement partagée avec une scène OBS exportée), donc lui donner
# le jeton opérateur reviendrait à distribuer un contrôle complet du
# pipeline avec l'URL de l'overlay.
WS_VIEWER_TOKEN=