node_modules/
whisper/
*.wav
.env
.env.local
*.log

# Sortie de "npm run dist" (electron-builder) : .exe, .blockmap, dossier
# win-unpacked/, etc. Ce sont des artefacts de build (~100 Mo), jamais du
# code source — ils ne doivent jamais être commités. Le vrai .exe livré aux
# utilisateurs vit dans les Releases GitHub (voir .github/workflows/
# build-windows.yml), pas dans le dépôt git.
dist/

# Sortie de "npm run build" / "npm run build:ts" (tsc, voir tsconfig.json).
# CORRECTIF : outDir pointait vers "./dist" — le même dossier que ci-dessus,
# déjà exclusivement réservé à electron-builder par ce fichier lui-même.
# Les deux outils écrivant dans le même répertoire pour des sorties
# totalement différentes (fichiers .js/.d.ts/.map compilés vs. .exe/
# installeur packagé), l'un pouvait écraser ou polluer l'autre selon
# l'ordre d'exécution. Renommé en dist-ts/ (tsconfig.json), distinct.
dist-ts/

# Sortie de "npm run test:e2e" (Playwright — voir playwright.config.js) :
# rapport HTML + traces/captures d'écran des tests échoués. Régénérés à
# chaque exécution, jamais du code source.
test-results/
playwright-report/
