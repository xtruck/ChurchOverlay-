node_modules/
whisper/
*.wav
# CORRECTIF (CI) : les échantillons de test speech test*_16k.wav /
# test*_raw.wav sont PETITS (< 250 Ko) et REQUIS par la suite de tests
# (test-silero-vad.js exige testA_16k.wav, deepgram-live-test.js les 4).
# Les corpus de bench (bloc*.wav) restent ignorés : volumineux et régénérés
# via live-tests/samples/tts-synth/ (CORPUS-SCRIPT.md).
!live-tests/samples/test*_16k.wav
!live-tests/samples/test*_raw.wav
.env
.env.local
*.log

# Sortie de "npm run dist" (electron-builder) : .exe, .blockmap, dossier
# win-unpacked/, etc. Ce sont des artefacts de build (~100 Mo), jamais du
# code source — ils ne doivent jamais être commités. Le vrai .exe livré aux
# utilisateurs vit dans les Releases GitHub (voir .github/workflows/
# build-windows.yml), pas dans le dépôt git.
dist/

# POC isolé de faisabilité Qwen3-ASR (voir QWEN3-ASR-FEASIBILITY.md) — le
# code du POC (benchmark*.js, resample.js, package.json) reste commité,
# mais PAS le modèle téléchargé (~705 Mo décompressé, ~879 Mo l'archive) ni
# ses dépendances : un dépôt git n'est pas fait pour stocker des binaires de
# cette taille, et ce POC est volontairement isolé du pipeline de
# production (voir asr-engine.js, provider 'qwen-local' toujours réservé).
poc-qwen3-asr/node_modules/
poc-qwen3-asr/model.tar.bz2
poc-qwen3-asr/sherpa-onnx-qwen3-asr-*/
poc-qwen3-asr/samples/
poc-qwen3-asr/package-lock.json

# Sortie de "npm run build" / "npm run build:ts" (tsc, voir tsconfig.json).
# CORRECTIF : outDir pointait vers "./dist" — le même dossier que ci-dessus,
# déjà exclusivement réservé à electron-builder par ce fichier lui-même.
# Les deux outils écrivant dans le même répertoire pour des sorties
# totalement différentes (fichiers .js/.d.ts/.map compilés vs. .exe/
# installeur packagé), l'un pouvait écraser ou polluer l'autre selon
# l'ordre d'exécution. Renommé en dist-ts/ (tsconfig.json), distinct.
dist-ts/

# Index vectoriel biblique (chantier 4.2 — voir scripts/generate-bible-
# embeddings.js, bible-vector-store.js). ~31 000 versets x 768 floats +
# métadonnées : dizaines de Mo, régénéré à volonté par le script ci-dessus
# (GEMINI_API_KEY requis) — un dépôt git n'est pas fait pour ce genre de
# binaire, même principe que poc-qwen3-asr/model.tar.bz2 ci-dessus. Livré via
# le pipeline de build/release, pas commité (à la différence du petit
# models/silero_vad.onnx, 2,3 Mo, qui lui reste commité).
models/bible-vector-index.sqlite3
# CORRECTIF (2026-08-25) : scripts/generate-bible-embeddings.js construit
# maintenant dans ce fichier temporaire avant de le renommer vers le chemin
# ci-dessus une fois la génération complète (voir son en-tête) -- sans cette
# ligne, une génération interrompue laisserait un .building non ignoré.
models/bible-vector-index.sqlite3.building

# Sortie de "npm run test:e2e" (Playwright — voir playwright.config.js) :
# rapport HTML + traces/captures d'écran des tests échoués. Régénérés à
# chaque exécution, jamais du code source.
test-results/
playwright-report/
